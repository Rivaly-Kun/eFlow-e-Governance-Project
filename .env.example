# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Private Python services only. Never prefix this value with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Gateway/runtime configuration
EFLOW_ALLOWED_ORIGINS=https://YOUR_EFLOW_FRONTEND.example
EFLOW_INTERNAL_AI_BASE_URL=http://127.0.0.1:8321/controlpanelEflow/api
EFLOW_AI_TIMEOUT_SECONDS=7200

# Optional Super Admin Backup & Export support. This direct Postgres URL stays
# on the Python gateway and must never use a VITE_ prefix.
EFLOW_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
EFLOW_PG_DUMP_PATH=pg_dump
EFLOW_BACKUP_RETENTION_HOURS=24
